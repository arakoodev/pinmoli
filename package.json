{
  "name": "pinmoli",
  "version": "0.1.0",
  "description": "Standalone SIP/WebRTC testing agent built with pi libraries",
  "type": "module",
  "bin": {
    "pinmoli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src test",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint src test --fix"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.54.0",
    "@mariozechner/pi-ai": "^0.54.0",
    "@mariozechner/pi-tui": "^0.54.0",
    "@sinclair/typebox": "^0.34.0",
    "better-sqlite3": "^11.0.0",
    "sip": "^0.0.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.0.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "eslint": "^8.57.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
