{
  "name": "pinmoli",
  "version": "0.1.0",
  "description": "Standalone SIP/WebRTC testing agent built with pi libraries",
  "type": "module",
  "bin": {
    "pinmoli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run test/unit/ test/integration/",
    "test:all": "vitest run",
    "test:live": "vitest run test/live/",
    "test:watch": "vitest",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src test",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint src test --fix",
    "build:play": "esbuild src/cli-play.ts --bundle --platform=node --target=node20 --format=esm --outfile=bin/pinmoli-play.mjs --banner:js='#!/usr/bin/env node' --external:koffi --external:better-sqlite3"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.54.0",
    "@mariozechner/pi-ai": "^0.54.0",
    "@mariozechner/pi-tui": "^0.54.0",
    "@sinclair/typebox": "^0.34.0",
    "better-sqlite3": "^11.0.0",
    "livekit-server-sdk": "^2.15.0",
    "sip": "^0.0.6",
    "werift": "^0.22.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  }
}
